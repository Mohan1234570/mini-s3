{
  "title": "Mini S3 — Storage Dashboard",
  "panels": [
    {
      "title": "Upload Throughput (req/s)",
      "type": "stat",
      "targets": [{
        "expr": "rate(minis3_objects_uploaded_total[1m])",
        "legendFormat": "uploads/s"
      }]
    },
    {
      "title": "Download Throughput (req/s)",
      "type": "stat",
      "targets": [{
        "expr": "rate(minis3_objects_downloaded_total[1m])",
        "legendFormat": "downloads/s"
      }]
    },
    {
      "title": "Upload P99 Latency (ms)",
      "type": "stat",
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(minis3_upload_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 ms"
      }]
    },
    {
      "title": "Download P99 Latency (ms)",
      "type": "stat",
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(minis3_download_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 ms"
      }]
    },
    {
      "title": "Metadata Lookup P99 (ms)",
      "type": "stat",
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(minis3_metadata_lookup_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 ms"
      }]
    },
    {
      "title": "Cache Hit Rate (%)",
      "type": "gauge",
      "targets": [{
        "expr": "rate(minis3_cache_hits_total[5m]) / (rate(minis3_cache_hits_total[5m]) + rate(minis3_cache_misses_total[5m])) * 100",
        "legendFormat": "Hit Rate"
      }]
    },
    {
      "title": "Healthy Storage Nodes",
      "type": "stat",
      "targets": [{
        "expr": "minis3_nodes_healthy",
        "legendFormat": "Nodes UP"
      }]
    },
    {
      "title": "Total Bytes Stored",
      "type": "stat",
      "targets": [{
        "expr": "minis3_storage_bytes_total",
        "legendFormat": "Bytes"
      }]
    },
    {
      "title": "Replication Success vs Failure",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(minis3_replication_success_total[1m])",
          "legendFormat": "success/s"
        },
        {
          "expr": "rate(minis3_replication_failure_total[1m])",
          "legendFormat": "failure/s"
        }
      ]
    }
  ],
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" }
}